rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Store Settings (readable and configurable by store administration and seeding)
    match /storeSettings/{settingId} {
      allow read, write: if true;
    }

    // Products catalog (readable by visitors, manageable by administration and order stock reduction)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Banners
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Orders (customers can place and track orders; admins can manage and update statuses)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Product reviews and ratings
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Affiliates and Creators
    match /affiliates/{affiliateId} {
      allow read, write: if true;
    }

    // Payout requests
    match /payouts/{payoutId} {
      allow read, write: if true;
    }

    // Affiliate transactions
    match /affiliateTransactions/{transId} {
      allow read, write: if true;
    }

    // Test connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default match for any subcollections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
